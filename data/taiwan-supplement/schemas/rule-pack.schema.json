{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gym-come-true.invalid/schemas/rule-pack.schema.json",
  "title": "Taiwan deterministic supplement rule pack",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packId",
    "version",
    "jurisdiction",
    "status",
    "generatedAtIsoDate",
    "sourceIds",
    "rules",
    "testCaseIds",
    "productionAdmitted"
  ],
  "properties": {
    "packId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "jurisdiction": { "const": "TW" },
    "status": { "enum": ["MISSING", "DRAFT", "CLINICALLY_REVIEWED"] },
    "generatedAtIsoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "effectiveFrom": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "effectiveUntil": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "contentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "rules": { "type": "array" },
    "testCaseIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "reviewerAttestation": { "type": ["object", "null"] },
    "rollbackToVersion": { "type": ["string", "null"] },
    "productionAdmitted": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "CLINICALLY_REVIEWED" } } },
      "then": {
        "required": ["contentSha256", "reviewerAttestation", "rollbackToVersion"],
        "properties": {
          "productionAdmitted": { "const": true },
          "sourceIds": { "minItems": 1 },
          "rules": { "minItems": 1 }
        }
      },
      "else": {
        "properties": { "productionAdmitted": { "const": false } }
      }
    }
  ]
}
