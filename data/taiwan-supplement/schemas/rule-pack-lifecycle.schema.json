{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gym-come-true.invalid/schemas/rule-pack-lifecycle.schema.json",
  "title": "Taiwan rule-pack promotion, suspension, revocation, expiry, and rollback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jurisdiction",
    "candidate",
    "requiredPromotionOrder",
    "terminalOrRecoveryStates",
    "events",
    "resolvedState",
    "productionAdmitted",
    "note"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jurisdiction": {
      "const": "TW"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "requiredPromotionOrder": {
      "const": [
        "DRAFT",
        "REVIEWED",
        "STAGED",
        "ACTIVE"
      ]
    },
    "terminalOrRecoveryStates": {
      "type": "array",
      "items": {
        "enum": [
          "SUSPENDED",
          "REVOKED",
          "EXPIRED",
          "ROLLED_BACK"
        ]
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "resolvedState": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "STAGED",
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "EXPIRED",
        "ROLLED_BACK"
      ]
    },
    "productionAdmitted": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId",
        "version",
        "generatedAtIsoDate",
        "effectiveFromIsoDate",
        "effectiveUntilIsoDate",
        "contentSha256",
        "sourceBundleSha256",
        "testSuiteSha256",
        "reviewerAttestationSha256",
        "userFacingWordingSha256",
        "mappingIds",
        "rollbackToVersion",
        "modelUsedForDecision",
        "productionAdmitted"
      ],
      "properties": {
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generatedAtIsoDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "effectiveFromIsoDate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "effectiveUntilIsoDate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "contentSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceBundleSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "testSuiteSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewerAttestationSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "userFacingWordingSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "mappingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rollbackToVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "modelUsedForDecision": {
          "const": false
        },
        "productionAdmitted": {
          "const": false
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "action",
        "occurredAtIsoDate",
        "actorSignatureSha256",
        "reasonCode",
        "incidentId",
        "targetVersion"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "REVIEW",
            "STAGE",
            "ACTIVATE",
            "SUSPEND",
            "RESUME",
            "REVOKE",
            "EXPIRE",
            "ROLLBACK"
          ]
        },
        "occurredAtIsoDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "actorSignatureSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "incidentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "SUSPEND",
                  "RESUME",
                  "REVOKE",
                  "ROLLBACK"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "reasonCode": {
                "type": "string",
                "minLength": 1
              },
              "incidentId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "ROLLBACK"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "targetVersion": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
