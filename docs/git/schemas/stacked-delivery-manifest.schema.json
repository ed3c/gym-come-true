{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gym-come-true/stacked-delivery-manifest/v1",
  "title": "Machine-verifiable stacked delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "narrativeSource", "gitTownRuntime", "evalSets", "packets"],
  "properties": {
    "schema": {
      "const": "gym-come-true/stacked-delivery-manifest/v1"
    },
    "narrativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "docs/git/STACKED_PRS.md" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "gitTownRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "canary", "runtimeAdmitted"],
      "properties": {
        "executable": { "enum": ["ABSENT", "PINNED_CANDIDATE", "ADMITTED"] },
        "canary": { "enum": ["NOT_EXERCISED", "EXECUTED"] },
        "runtimeAdmitted": { "type": "boolean" }
      }
    },
    "evalSets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^E-[A-Z]+$" }
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packet" }
    }
  },
  "$defs": {
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "issue",
        "parents",
        "head",
        "transition",
        "pathLease",
        "evals",
        "negativeControls",
        "rollback",
        "humanAdmit"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
        "status": {
          "enum": ["PLANNED_WORK_PACKET", "OPEN_DRAFT_PR", "MERGED_TO_MAIN", "DELIVERED_ON_MAIN"]
        },
        "pullRequest": { "type": "integer", "minimum": 1 },
        "issue": { "type": "integer", "minimum": 1 },
        "mergedHeadSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "parents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "head": { "type": "string", "pattern": "^(main|agent/[a-z0-9-]+)$" },
        "transition": { "type": "string", "pattern": "^[A-Z0-9_]+ -> [A-Z0-9_]+$" },
        "pathLease": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "negativeControls": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rollback": { "type": "string", "minLength": 1 },
        "externalGate": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "humanAdmit": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
